{
  "$comment": "Driver Center catalog. One entry per device family. `status`: verified (tested on hub hardware), available (driver ships with the packages install.sh installs; not hardware-tested), needs_file (works only after the admin uploads a vendor file), unsupported (no Linux driver). Runtime verdicts (readiness, PPD index, hwdb) override these claims for a connected device. Never put the vendor files themselves in this repository.",
  "version": 1,
  "recipes": [
    {
      "id": "canon-g3030",
      "kind": "mfp",
      "vendor": "Canon",
      "family": "PIXMA G3030 series (G1010/G2010/G2020/G3010/G3020/G3030)",
      "match": { "usb_vendor": "04a9", "usb_products": ["18da", "18ea", "18b7"], "model": "(G3030|G3020|G3010|G2020|G2010|G1020|G1010)" },
      "print": { "how": "driverless", "note": "IPP-over-USB via ipp-usb, CUPS Everywhere" },
      "scan": { "how": "escl", "note": "eSCL via ipp-usb (sane-airscan)" },
      "status": "verified"
    },
    {
      "id": "canon-lbp6030-ufr2lt",
      "kind": "printer",
      "vendor": "Canon",
      "family": "LBP6030 / LBP6040 / LBP6018 / LBP6230 / LBP112 / LBP113w / LBP151dw / LBP7110Cw (UFR II LT)",
      "match": { "usb_vendor": "04a9", "model": "LBP(6030|6040|6018|6230|6200|112|113|151|7110|8100)" },
      "print": { "how": "vendor_deb", "package": "cnrdrvcups-ufr2lt-uk", "note": "Canon UFR II LT (rastertosfp)" },
      "requires": [{ "kind": "deb", "package": "cnrdrvcups-ufr2lt-uk", "arch": ["arm64", "amd64"], "download": "https://www.canon-europe.com/support/", "note": "Canon's proprietary UFR II LT driver. Download the Linux .deb for your architecture from Canon's support site and upload it here." }],
      "status": "verified",
      "note": "LBP6030 verified on hub hardware. The Canon driver package is licensed for the user's own machines only, so the hub can't ship it: upload it once."
    },
    {
      "id": "canon-capt",
      "kind": "printer",
      "vendor": "Canon",
      "family": "LBP2900 / LBP3000 / LBP3010 / LBP3018 / LBP3050 / LBP6000 / LBP6018 (CAPT)",
      "match": { "usb_vendor": "04a9", "model": "LBP(2900|3000|3010|3018|3050|6000\\b|6018\\b)" },
      "print": { "how": "bundled", "package": "captdriver", "note": "Open-source captdriver (rastertocapt), compiled by install.sh" },
