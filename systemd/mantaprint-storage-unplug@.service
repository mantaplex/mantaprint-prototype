[Unit]
Description=MantaPrint Storage Hot-Unplug Handler for %I
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mantaprint-storage-manager.sh handle-unplug %I
TimeoutSec=30
Nice=0
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
StandardOutput=journal
StandardError=journal
