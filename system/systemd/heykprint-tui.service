[Unit]
Description=HeykPrint Hub - Enterprise Console Terminal User Interface (TUI)
After=heykprint-web.service systemd-networkd.service
Conflicts=getty@tty1.service heykprint-hdmi.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment="TERM=linux"
Environment="LANG=C.UTF-8"
ExecStartPre=/usr/bin/setfont /usr/share/consolefonts/Uni3-TerminusBold16.psf.gz -C /dev/tty1
ExecStart=/usr/bin/node /opt/heykprint/tui/app.mjs
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=true
TTYVHangup=true
TTYVTDisallocate=true

Restart=on-failure
RestartSec=3
KillMode=control-group
SuccessExitStatus=SIGKILL 143

# Realtime Interactive Scheduling Priority
Nice=-2

# Cgroup Resource Limits: Ultra-lightweight footprint (<35MB RAM)
CPUAccounting=true
CPUWeight=120
MemoryAccounting=true
MemoryHigh=64M
MemoryMax=96M

[Install]
WantedBy=multi-user.target
