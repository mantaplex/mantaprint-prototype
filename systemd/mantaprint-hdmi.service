[Unit]
Description=MantaPrint Hub - Enterprise HDMI 10-Foot Console
After=mantaprint-web.service systemd-networkd.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment="XDG_RUNTIME_DIR=/run/user/0"
Environment="WLR_BACKENDS=drm,libinput"
Environment="WLR_DRM_DEVICES=/dev/dri/card0"
Environment="WLR_DRM_NO_MODIFIERS=1"
Environment="WLR_NO_HARDWARE_CURSORS=1"
Environment="COG_PLATFORM_WL_VIEW_FULLSCREEN=1"
Environment="WEBKIT_WEB_RENDER_DEVICE_FILE=/dev/dri/renderD128"
ExecStartPre=/bin/mkdir -p -m 0700 /run/user/0
ExecStart=/usr/bin/cage -d -s -m last -- /usr/local/bin/mantaprint-hdmi-runner
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
SuccessExitStatus=SIGKILL 143
StandardOutput=journal
StandardError=journal

# Interactive Scheduling Priority: Zero UI lag upon input
Nice=-2

# Cgroup Resource Limits: Abundant 1GB+ RAM headroom from 1.6GB free RAM
CPUAccounting=true
CPUWeight=120
MemoryAccounting=true
MemoryHigh=1024M
MemoryMax=1400M

[Install]
WantedBy=multi-user.target

