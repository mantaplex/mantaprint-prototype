#!/bin/bash
# /usr/local/bin/heykprint-hdmi-trigger
# HeykPrint Hub - Zero-Idle HDMI Console Lifecycle Manager
# Built with flock and 500ms debounce hysteresis to prevent HPD pin contact bounce

set -eu

SERVICE_NAME="heykprint-tui.service"
LEGACY_SERVICE="heykprint-hdmi.service"

# Non-blocking lock: drop parallel udev flapping bursts
exec 200>"$LOCK_FILE"
flock -n 200 || exit 0

# Debounce delay: allow mechanical contact bounce to settle
sleep 0.5

# Detect live connector status directly from kernel sysfs
HDMI_STATUS="disconnected"
for status_path in /sys/class/drm/card*-HDMI-A-*/status; do
    if [ -f "$status_path" ]; then
        HDMI_STATUS=$(cat "$status_path" 2>/dev/null || echo "disconnected")
        break
    fi
done

if [ "$HDMI_STATUS" = "connected" ]; then
    if systemctl is-active --quiet "$LEGACY_SERVICE"; then
        systemctl stop "$LEGACY_SERVICE" 2>/dev/null || true
    fi
    if ! systemctl is-active --quiet "$SERVICE_NAME"; then
        systemctl start "$SERVICE_NAME"
    fi
elif [ "$HDMI_STATUS" = "disconnected" ]; then
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        systemctl stop "$SERVICE_NAME"
    fi
    if systemctl is-active --quiet "$LEGACY_SERVICE"; then
        systemctl stop "$LEGACY_SERVICE" 2>/dev/null || true
    fi
fi
