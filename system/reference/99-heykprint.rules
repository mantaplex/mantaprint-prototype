# /etc/udev/rules.d/99-heykprint.rules
# HeykPrint Event-Driven Hotplug Rules for Armbian S905X

# 1. Match classic USB printers exposing usbmisc (e.g. /dev/usb/lp0, lp1...)
ACTION=="add", SUBSYSTEM=="usbmisc", KERNEL=="lp*", \
  RUN+="/usr/bin/python3 /opt/heykprint/heykprint-ctl.py udev-event add %E{DEVNAME} %E{DEVPATH}"

ACTION=="remove", SUBSYSTEM=="usbmisc", KERNEL=="lp*", \
  RUN+="/usr/bin/python3 /opt/heykprint/heykprint-ctl.py udev-event remove %E{DEVNAME} %E{DEVPATH}"

# 2. Match IPP-over-USB capable devices (Interface Class 07, Subclass 01, Protocol 04)
ACTION=="add", SUBSYSTEM=="usb", \
  ATTR{bInterfaceClass}=="07", ATTR{bInterfaceSubClass}=="01", ATTR{bInterfaceProtocol}=="04", \
  RUN+="/usr/bin/python3 /opt/heykprint/heykprint-ctl.py udev-event add-ippusb %E{DEVNAME} %E{DEVPATH}"

ACTION=="remove", SUBSYSTEM=="usb", \
  ENV{ID_USB_INTERFACES}=="*:070104:*", \
  RUN+="/usr/bin/python3 /opt/heykprint/heykprint-ctl.py udev-event remove-ippusb %E{DEVNAME} %E{DEVPATH}"
