#!/usr/bin/env bash
# MantaPrint lockdown mode (print-only) - boot-time re-apply and manual control.
#   mantaprint-lockdown apply   : load /etc/mantaprint/lockdown.nft if lockdown is enabled
#   mantaprint-lockdown clear   : remove the ruleset (does not change the enabled flag)
#   mantaprint-lockdown status  : print enabled/applied
# The ruleset itself is generated by the hub (src/web/server/lockdown.mjs); the switch is in
# the TUI and Admin > Settings. Turning lockdown off from the shell: clear + set "enabled":
# false in /etc/mantaprint/lockdown.json.
set -u
CONF=/etc/mantaprint/lockdown.json
RULES=/etc/mantaprint/lockdown.nft
TABLE=mantaprint_lockdown

enabled() { [ -f "$CONF" ] && grep -Eq '"enabled"[[:space:]]*:[[:space:]]*true' "$CONF"; }
applied() { nft list table inet "$TABLE" >/dev/null 2>&1; }

case "${1:-status}" in
  apply)
    if ! enabled; then echo "lockdown: disabled, nothing to apply"; exit 0; fi
    if ! command -v nft >/dev/null 2>&1; then echo "lockdown: nft missing (install nftables)" >&2; exit 1; fi
    if [ ! -f "$RULES" ]; then echo "lockdown: enabled but $RULES missing" >&2; exit 1; fi
    nft -f "$RULES" && systemctl disable --now cups-browsed.service >/dev/null 2>&1 || true
    applied && echo "lockdown: applied (print-only)" || { echo "lockdown: failed to apply" >&2; exit 1; }
    ;;
  clear)
    applied && nft delete table inet "$TABLE"
    echo "lockdown: ruleset cleared"
    ;;
  status)
    echo "enabled=$(enabled && echo yes || echo no) applied=$(applied && echo yes || echo no)"
    ;;
  *) echo "usage: $0 {apply|clear|status}" >&2; exit 2 ;;
esac
