#!/bin/bash
# /usr/local/bin/heykprint-hdmi-runner
# HeykPrint HDMI Kiosk Session Launcher
# Clamps display resolution to 720p (HD 1280x720) to minimize GPU fillrate,
# memory bus saturation, and thermal dissipation on Amlogic S905X.

set -eu

# Asynchronously set display resolution to 720p (HD 1280x720)
(
  sleep 1.0

  # Query available 720p modes from compositor, prioritizing 60Hz then 50Hz
  MODE_720=$(wlr-randr 2>/dev/null | awk '/HDMI-A-1/,/^$/' | grep -E '^[[:space:]]*1280x720' | sed -E -n 's/^[[:space:]]*([0-9]+x[0-9]+) px, ([0-9.]+) Hz.*/\1@\2Hz/p' | head -n 1 || true)

  if [ -n "$MODE_720" ]; then
    wlr-randr --output HDMI-A-1 --mode "$MODE_720" 2>/dev/null || true
  else
    wlr-randr --output HDMI-A-1 --mode 1280x720@60.000000Hz 2>/dev/null || \
    wlr-randr --output HDMI-A-1 --mode 1280x720@60Hz 2>/dev/null || \
    wlr-randr --output HDMI-A-1 --mode 1280x720@50.000000Hz 2>/dev/null || \
    wlr-randr --output HDMI-A-1 --mode 1280x720@50Hz 2>/dev/null || \
    wlr-randr --output HDMI-A-1 --mode 1280x720 2>/dev/null || true
  fi
) &

exec /usr/bin/cog -P wl --enable-smooth-scrolling=0 --web-mem-limit=768 http://127.0.0.1:80/hdmi

